# TouchRoute Configuration

# Environment: development | production
ENVIRONMENT=development

# Database (defaults to local SQLite for zero-setup dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./touchroute.db
# DATABASE_URL=postgresql://touchroute:touchroute_password@localhost:5432/touchroute_db

# AI Provider ("gemini" | "nvidia" | "groq" | "meta")
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_VOICE_MODEL=gemini-2.5-flash-preview-tts
NVIDIA_API_KEY=your_nvidia_nim_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.2-11b-vision-preview
META_API_KEY=your_meta_api_key_here

# Backend Service
PORT=8000

